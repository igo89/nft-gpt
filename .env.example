# Required configuration for the NFT floor sniper
COLLECTION_SLUG=
MAX_PRICE_ETH=0.5
DISCOUNT_PERCENT=5
POLLING_INTERVAL_MS=3000
RPC_URL=
WALLET_PRIVATE_KEY=

# Optional OpenSea API key for higher rate limits
OPENSEA_API_KEY=

# Optional override for marketplace request timeout (milliseconds)
REQUEST_TIMEOUT_MS=4000

# Set to "false" to disable automatic bootstrap when importing in tests
BOOTSTRAP=true
